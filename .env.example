# Azure
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-magentictest
AZURE_LOCATION=eastus

# Foundry projects (set after Bicep deploy)
FOUNDRY_PLANT_PROJECT_ENDPOINT=
FOUNDRY_ENTERPRISE_PROJECT_ENDPOINT=

# Foundry IQ KBs (set after seed)
FOUNDRY_IQ_KB_PLANT7_ID=
FOUNDRY_IQ_KB_PLANT4_ID=
FOUNDRY_IQ_KB_ENTERPRISE_ID=

# Foundry IQ KB MCP wiring (set after KB + agents exist; operator creates the
# IQ project connection, then these env vars cause the factory to bake the MCP
# tool into every new agent version — no portal step required).
PLANT_KB_CONNECTION_ID=
PLANT_KB_MCP_URL=
PLANT4_KB_CONNECTION_ID=
PLANT4_KB_MCP_URL=
ENTERPRISE_KB_CONNECTION_ID=
ENTERPRISE_KB_MCP_URL=

# Reasoning model (D2: configurable)
MMC_MODEL_PROVIDER=azure_openai
MMC_MODEL_DEPLOYMENT=gpt-5-reasoning
MMC_MODEL_ENDPOINT=
MMC_MODEL_FALLBACK_DEPLOYMENT=gpt-4o

# Azure SQL (set after SQL Bicep deploy) — used by provision_sql.py / grant_sql_access.py
SQL_SERVER_FQDN=
SQL_DATABASE_NAME=mmcops

# Search service managed-identity object ids (grant_sql_access.py grants them
# db_datareader on the SQL DB). Get each after deploy with:
#   az search service show -n <search-name> -g <rg> --query identity.principalId -o tsv
SEARCH_PLANT_MI_OBJECT_ID=
SEARCH_PLANT4_MI_OBJECT_ID=
SEARCH_ENTERPRISE_MI_OBJECT_ID=
